# Local development (apply migrations first). Use independent random passwords.
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://saas_app_user:replace_app_password@localhost:5432/saas_production
DATABASE_MIGRATION_URL=postgresql://saas_control:replace_control_password@localhost:5432/saas_production
API_INTERNAL_URL=http://localhost:4000
# Docker: use URL-safe random hex strings for passwords (openssl rand -hex 32).
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
CONTROL_DATABASE_PASSWORD=
