{
  "name": "enterprise-saas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade, multi-tenant B2B SaaS platform foundation",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.64.7",
      "lodash": "4.18.1",
      "js-yaml": "4.3.2",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "multer": "2.4.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ]
